        "description": "Order management and processing",
        "responsibilities": ["order creation", "order validation", "order tracking"]
      },
      {
        "id": "payment-service",
        "description": "Payment processing",
        "responsibilities": ["payment authorization", "refunds", "webhooks"]
      },
      {
        "id": "inventory-service",
        "description": "Inventory management",
        "responsibilities": ["stock tracking", "reservations", "availability"]
      },
      {
        "id": "user-service",
        "description": "User management",
        "responsibilities": ["authentication", "profile management", "preferences"]
      },
      {
        "id": "analytics-service",
        "description": "Analytics and metrics",
        "responsibilities": ["event processing", "aggregation", "reporting"]
      },
      {
        "id": "notification-service",
        "description": "Notification system",
        "responsibilities": ["email", "SMS", "push notifications"]
      },
      {
        "id": "service-mesh",
        "description": "Service mesh infrastructure",
        "responsibilities": ["traffic management", "security", "observability"]
      },
      {
