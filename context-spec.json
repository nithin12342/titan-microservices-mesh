        "Service communication",
        "Service discovery",
        "Load balancing",
        "Circuit breaking",
        "Distributed tracing"
      ],
      "upstream_dependencies": [
        "nebula-cloud-platform"
      ],
      "downstream_consumers": [
        "aurora-fullstack-saas"
      ]
    },
    "key_components": [
      {
