    "technology_stack": {
      "languages": ["Go", "Rust", "Java", "Node.js", "Python"],
      "service_mesh": ["Istio", "Linkerd", "Azure Service Fabric"],
      "resilience": ["Resilience4j", "go-breaker", "circuitbreaker"],
      "databases": ["PostgreSQL (Azure DB)", "Cosmos DB", "MongoDB (Atlas)", "Redis (Azure)", "ClickHouse"],
      "messaging": ["Azure Service Bus", "RabbitMQ", "NATS"]
